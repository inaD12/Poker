{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../Logs/log-.txt",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DatabaseOptions": {
    "ConnectionString": ""
  },
  "AuthOptions": {
    "SecretKey": "c5e858c98ea365732202554c708b2052e784c3384a1e77485dd2b4e0dd204aef",
    "Audience": "--",
    "Issuer": "PokerGame",
    "SecondsValid": "3000000"
  },
  "CorsOptions": {
    "AllowedOrigins": "http://localhost:3000, http://localhost:3001, http://poker-client-defge7aub6gkbrcy.westeurope-01.azurewebsites.net, https://poker-client-defge7aub6gkbrcy.westeurope-01.azurewebsites.net"
  },
  "AllowedHosts": "*"
}
