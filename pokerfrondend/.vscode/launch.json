{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: debug server-side (Turbopack)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev"
    },
    {
      "name": "Next.js: debug client-side (Firefox, Turbopack)",
      "type": "firefox",
      "request": "launch",
      "url": "http://localhost:3000",
      "reAttach": true,
      "webRoot": "${workspaceFolder}",
      "pathMappings": [
        {
          "url": "file:///home/inad/Desktop/Projects/Poker/pokerfrondend/src/app/page.tsx",
          "path": "${workspaceFolder}/src/app/lobbies/[pageNumber]/page.tsx"
        },
        {
          "url": "file:///home/inad/Desktop/Projects/Poker/pokerfrondend/src/app/page.tsx",
          "path": "${workspaceFolder}/src/app/lobbies/[pageNumber]/page.tsx"
        },
        {
          "url": "webpack:///src/app/lobby/[id]/page.tsx",
          "path": "${workspaceFolder}/src/app/lobby/[id]/page.tsx"
        },
        {
          "url": "webpack:///src/app/lobbies/[pageNumber]/page.tsx",
          "path": "${workspaceFolder}/src/app/lobbies/[pageNumber]/page.tsx"
        },
        {
          "url": "webpack:///src/app/page.tsx",
          "path": "${workspaceFolder}/src/app/page.tsx"
        }
      ]
    },
    {
      "name": "Next.js: debug full stack (Turbopack)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": [
        "dev"
      ],
      "runtimeArgs": [
        "--inspect"
      ],
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
